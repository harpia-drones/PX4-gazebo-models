<?xml version='1.0' encoding='utf-8'?>
<sdf version='1.10'>
  <world name='FRTL25world'>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8000000000000007</gravity>
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <scene>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
      <sky/>
      <shadows>true</shadows>
    </scene>

    <!--Chao-->
    <model name="ground">
			<include>
        <uri>models/ground</uri>
      </include>
		</model>

    <!--Grama-->
    <model name="grass">
			<include>
        <uri>models/grass</uri>
      </include>
      <pose>0 0 -0.4 0 0 0</pose>
		</model>

    <!--Parede leste -->
    <model name="wall_east">
			<include>
        <uri>models/wall</uri>
      </include>
      <pose>8.05 4.05 2.5 0 0 3.141598653589793</pose>  <!-- rotacionado por 180 graus em radianos-->
		</model>

    <!--Parede Sul-->
    <model name="wall_south">
			<include>
        <uri>models/wall</uri>
      </include>
      <pose>4.05 -0.05 2.5 0 0 -1.5707963267948965</pose>  <!-- rotacionado por -90 graus em radianos-->
		</model>

     <!--Takeoff base-->
    <model name="takeoff">
			<include>
        <uri>models/takeoff_base</uri>
      </include>
      <pose>1 0.75 0.25 0 0 0</pose>
		</model>

    <!--5 bases-->
    <model name="moving1">
			<include>
        <uri>models/moving_base</uri>
      </include>
      <pose>4.5 6.5 0.05 0 0 0</pose>
		</model>
    <model name="high1">
			<include>
        <uri>models/high_base</uri>
      </include>
      <pose>1.5 6.0 0.5 0 0 0</pose>
		</model>
    <model name="high2">
			<include>
        <uri>models/high_base</uri>
      </include>
      <pose>4.0 4.5 0.5 0 0 0</pose>
		</model>
    <model name="moving2">
			<include>
        <uri>models/moving_base</uri>
      </include>
      <pose>1.0 3.0 0.05 0 0 0</pose>
		</model>
    <model name="high3">
			<include>
        <uri>models/high_base</uri>
      </include>
      <pose>7.0 3.0 0.5 0 0 0</pose>
		</model>
    <model name="moving3">
			<include>
        <uri>models/moving_base</uri>
      </include>
      <pose>3.5 1.25 1.55 0 0 0</pose>
		</model>


    <!-- Fase 4-->
      <model name="phase_4_enviroment">
        <include>
          <uri>models/phase_4_enviroment</uri>
        </include>
      <pose>5.0 1.0 0.75 0 0 0</pose>
		</model>

    <!-- Luz -->
    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.10000000000000001 -0.90000000000000002</direction>
      <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
      <specular>0.200000003 0.200000003 0.200000003 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.90000000000000002</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <spherical_coordinates>
		<surface_model>EARTH_WGS84</surface_model>
		<world_frame_orientation>ENU</world_frame_orientation>
		<latitude_deg>47.397971057728974</latitude_deg>
		<longitude_deg>8.546163739800146</longitude_deg>
		<elevation>0</elevation>
	</spherical_coordinates>

  </world>
</sdf>
